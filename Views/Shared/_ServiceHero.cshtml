@model (string Title, string? Eyebrow, string? Lead, string BgUrl)
<section class="service-hero">
    <div class="service-hero__bg" style="background-image:url('@Model.BgUrl')"></div>
    <div class="service-hero__overlay" aria-hidden="true"></div>
    <div class="container service-hero__inner">
        <nav class="breadcrumbs" aria-label="Brödsmulor">
            <a asp-controller="Home" asp-action="Index">Hem</a>
            <span> / </span>
            <a asp-controller="Services" asp-action="Index">Tjänster</a>
            <span> / </span>
            <span aria-current="page">@Model.Title</span>
        </nav>

        @if (!string.IsNullOrWhiteSpace(Model.Eyebrow))
        {
            <span class="eyebrow">@Model.Eyebrow</span>
        }

        <h1 class="display">@Model.Title</h1>

        @if (!string.IsNullOrWhiteSpace(Model.Lead))
        {
            <p class="lead">@Model.Lead</p>
        }

        <div class="hero-actions">
            <a class="btn btn-primary" href="mailto:hello@tasmim.se">Kontakta oss</a>
            <a class="btn btn-outline" asp-controller="Pricing" asp-action="Index">Se paket</a>
        </div>
    </div>
</section>
