
@{
    var light = Url.Content("~/img/logo.png");
    var dark = Url.Content("~/img/logo-white.png");
}
<a class="brand" asp-controller="Home" asp-action="Index" aria-label="Tasmim" style="display:inline-flex;align-items:center;text-decoration:none">
    <picture>
        <source srcset="@dark" media="(prefers-color-scheme: dark)">
        <img src="@light" alt="Tasmim" style="height:28px;display:block">
    </picture>
    <span class="sr-only">Tasmim</span>
</a>
