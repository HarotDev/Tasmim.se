@{
    ViewData["Title"] = "Priser – Tasmim";
    Layout = "_Layout";
}

<!-- ============ Section 1: PRICING (tabs + cards) ============ -->
<section class="section pricing-shell pricing-xl" id="pricing">
    <div class="container">

        <header class="section-head ta-center">
            <h1>Paket & priser</h1>
            <p class="muted">Välj Hemsida eller Webbutik – tre tydliga paket. Alltid mobilanpassat, snabbt och SEO-vänligt.</p>
        </header>

        <!-- Tabs -->
        <div class="p-tabs reveal" role="tablist" aria-label="Pakettyp ">
            <button class="p-tab is-active" role="tab" aria-selected="true"
                    aria-controls="panel-hemsida" id="tab-hemsida" data-tab="hemsida">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg>
                Hemsida
            </button>
            <button class="p-tab" role="tab" aria-selected="false"
                    aria-controls="panel-webbutik" id="tab-webbutik" data-tab="webbutik">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16l-1.5 9.5A2 2 0 0 1 16.5 18h-9A2 2 0 0 1 5 16.5L4 7zm2-4h12v2H6z" /></svg>
                Webbutik
            </button>
        </div>

        <!-- Panel: Hemsida -->
        <div class="p-panel is-active reveal" id="panel-hemsida" role="tabpanel" aria-labelledby="tab-hemsida">
            <div class="p-grid">
                <!-- Liten -->
                <article class="p-card" data-tone="soft">
                    <header class="p-head">
                        <p class="p-eyebrow">Komplett paket</p>
                        <h3>Hemsida Liten</h3>
                        <div class="p-price"><strong>5 000:-</strong><span>engångskostnad</span></div>
                    </header>
                    <ul class="p-list">
                        <li>Cirka 1–3 undersidor</li>
                        <li>Responsiv & tillgänglig design</li>
                        <li>Kontaktformulär + karta</li>
                        <li>AI-stött sökmotoroptimering</li>
                        <li>Anpassning efter era önskemål</li>
                        <li>Alla ändringar efter överenskommelse</li>
                        <li>Bild- och texthjälp</li>
                        <li>Koppling till sociala medier</li>
                        <li>Blogg/nyheter</li>
                        <li>Personlig kontakt</li>
                    </ul>
                    <footer class="p-cta">
                        <a class="p-btn p-btn-primary p-is-full"
                           asp-controller="Order" asp-action="New"
                           asp-route-category="Hemsida" asp-route-plan="Liten" asp-route-price="5000">Beställ</a>
                    </footer>
                </article>

                <!-- Mellan (featured) -->
                <article class="p-card is-featured" data-tone="brand">
                    <div class="p-ribbon">Populär</div>
                    <header class="p-head">
                        <p class="p-eyebrow">Komplett paket</p>
                        <h3>Hemsida Mellan</h3>
                        <div class="p-price"><strong>7 000:-</strong><span>engångskostnad</span></div>
                    </header>
                    <ul class="p-list">
                        <li>Cirka 1–7 undersidor</li>
                        <li>Snabb laddtid & Core Web Vitals</li>
                        <li>Kontaktformulär + karta</li>
                        <li>AI-stött sökmotoroptimering</li>
                        <li>Design efter varumärkesprofil</li>
                        <li>Alla ändringar efter överenskommelse</li>
                        <li>Bild- och texthjälp</li>
                        <li>Koppling till sociala medier</li>
                        <li>Blogg/nyheter</li>
                        <li>Personlig kontakt</li>
                    </ul>
                    <footer class="p-cta">
                        <a class="p-btn p-btn-primary p-is-full"
                           asp-controller="Order" asp-action="New"
                           asp-route-category="Hemsida" asp-route-plan="Mellan" asp-route-price="7000">Beställ</a>
                    </footer>
                </article>

                <!-- Stor -->
                <article class="p-card" data-tone="deep">
                    <header class="p-head">
                        <p class="p-eyebrow">Komplett paket</p>
                        <h3>Hemsida Stor</h3>
                        <div class="p-price"><strong>10 000:-</strong><span>engångskostnad</span></div>
                    </header>
                    <ul class="p-list">
                        <li>Cirka 1–15 undersidor</li>
                        <li>Utökad funktionalitet & integrationer</li>
                        <li>Kontaktformulär + karta</li>
                        <li>AI-stött sökmotoroptimering</li>
                        <li>Anpassad design efter behov</li>
                        <li>Alla ändringar efter överenskommelse</li>
                        <li>Bild- och texthjälp</li>
                        <li>Koppling till sociala medier</li>
