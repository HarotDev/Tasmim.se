                           asp-route-category="Webbutik" asp-route-plan="Mellan" asp-route-price="17000">Beställ</a>
                    </footer>
                </article>

                <!-- Stor -->
                <article class="p-card" data-tone="violet">
                    <header class="p-head">
                        <p class="p-eyebrow">Komplett paket</p>
                        <h3>Webbutik Stor</h3>
                        <div class="p-price"><strong>22 000:-</strong><span>engångskostnad</span></div>
                    </header>
                    <ul class="p-list">
                        <li>1–6 undersidor</li>
                        <li>Upp till ~100 produkter</li>
                        <li>Utökade funktioner & integrationer</li>
