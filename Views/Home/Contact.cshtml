@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer T
@model RaqmiWeb.Models.ContactVM

@{
    ViewData["Title"] = T["Kontakt"];
    Layout = "_Layout";
}

<section class="section contact-section reveal">
    <div class="container">
        <header class="section-head text-center">
            <h1 id="contact-title">@T["Välkommen att höra av dig"]</h1>
            <p>@T["Fyll i formuläret – vi återkommer inom 24 timmar."]</p>
        </header>

        @if (TempData["ContactOk"] as bool? == true)
        {
            <div class="alert success reveal in" role="status">
                <strong>@T["Tack!"]</strong> @T["Ditt meddelande är skickat."]
            </div>
        }

        <div class="contact-grid reveal">
            <form asp-action="Contact" method="post" class="contact-form card" novalidate>
                @Html.AntiForgeryToken()
                <div class="field">
                    <label for="Name">@T["Namn *"]</label>
                    <input asp-for="Name" class="input" />
                    <span asp-validation-for="Name" class="error"></span>
                </div>
                <div class="field">
                    <label for="Company">@T["Företag"]</label>
                    <input asp-for="Company" class="input" />
                    <span asp-validation-for="Company" class="error"></span>
                </div>
                <div class="field">
                    <label for="Phone">@T["Telefon"]</label>
                    <input asp-for="Phone" class="input" />
                    <span asp-validation-for="Phone" class="error"></span>
                </div>
                <div class="field">
                    <label for="Email">@T["E-post *"]</label>
                    <input asp-for="Email" class="input" />
                    <span asp-validation-for="Email" class="error"></span>
                </div>
                <div class="field">
                    <label for="Website">@T["Nuvarande webbplats"]</label>
                    <input asp-for="Website" class="input" />
                    <span asp-validation-for="Website" class="error"></span>
                </div>
                <div class="field">
                    <label for="Interest">@T["Vad gäller det? *"]</label>
                    <select asp-for="Interest" class="select">
                        <option value="" disabled selected>@T["Välj…"]</option>
                        <option>@T["Ny hemsida"]</option>
                        <option>@T["Webbutik / e-handel"]</option>
                        <option>@T["Design / UX"]</option>
                        <option>@T["SEO/SEM"]</option>
                        <option>@T["Support / annat"]</option>
                    </select>
                    <span asp-validation-for="Interest" class="error"></span>
                </div>
                <div class="field field--full">
                    <label for="Message">@T["Meddelande"]</label>
                    <textarea asp-for="Message" class="textarea" rows="5" placeholder="@T["Berätta kort vad du behöver hjälp med"]"></textarea>
                    <div class="hint"><span id="msg-count">0</span> @T["tecken"]</div>
                    <span asp-validation-for="Message" class="error"></span>
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" id="sendBtn" type="submit">@T["Skicka meddelande →"]</button>
                    <p class="small">@T["Genom att skicka godkänner du att vi kontaktar dig."]</p>
                </div>
            </form>

            <aside class="contact-aside card-dark">
                <ul class="ticks">
                    <li><span class="tick"></span>@T["Alla sidor är anpassade för SEO"]</li>
                    <li><span class="tick"></span>@T["Fasta priser & tydliga paket"]</li>
                    <li><span class="tick"></span>@T["Mobilanpassat och snabbt"]</li>
                    <li><span class="tick"></span>@T["Hjälp med texter & bilder"]</li>
                    <li><span class="tick"></span>@T["Trygg process från idé till lansering"]</li>
                </ul>
                <hr class="soft" />
                <div class="contact-ways">
                    <div class="way">
                        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M3 5l8 4 10-4-10 14L3 5z" fill="currentColor" opacity=".2" /><path d="M3 5l8 4 10-4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
                        <a href="mailto:info@tasmim.se">info@tasmim.se</a>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
