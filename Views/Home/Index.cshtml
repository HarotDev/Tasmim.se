@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer T

@{
    ViewData["Title"] = T["Digital byrå – Tasmim"];
    Layout = "_Layout";
}

<section class="hero" style="--overlay:.55;">
    <div class="hero__bg">
        <video class="hero__video"
               autoplay muted loop playsinline preload="auto"
               poster="">
            <source src="~/videos/video2.mp4" type="video/mp4" />
        </video>
    </div>
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="container hero__inner">
        <h1 class="hero-title">@T["Vi får ditt företag att växa"]</h1>
        <p class="hero-sub">
            @T["Vi kombinerar kreativitet, teknik och affärsdriv för att leverera allt från smart webbutveckling till effektfull marknadsföring."]
        </p>
        <div class="hero__actions">
            <a class="btn btn-wipe" asp-controller="Home" asp-action="Contact">@T["Kontakta oss"]</a>
            <a class="btn btn-ghost" asp-controller="Home" asp-action="References">@T["Referenser"]</a>
        </div>
    </div>
</section>

<section class="section section--soft">
    <div class="container reveal">
        <div class="grid grid-2 feature">
            <div class="feature-copy">
                <h2>@T["Vi gör det digitala lätt, snabbt och lite roligare"]</h2>
                <p>@T["Med kreativitet, teknik och affärer i perfekt mix levererar vi allt från vass webbutveckling till marknadsföring som gör skillnad."]</p>
                <a class="btn btn-wipetwo" asp-controller="Home" asp-action="About">@T["Läs mer om hur vi jobbar"]</a>
            </div>
            <div class="feature-media">
                <div class="square">
                    <img src="~/img/content/featuremediahome.jpg" alt="Team som arbetar med webbutveckling">
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section--word-planet">
    <div class="container text-center">
        <h2 class="planet-title">@T["Hemsidor för"]</h2>
        <br />
        <br />
        <div class="tagcloud-container">
            <span class="tagcloud-surface"></span>
        </div>

        <div class="tag-source" style="display: none;">
            <span>@T["Advokater"]</span>
            <span>@T["Hantverkare"]</span>
            <span>@T["Frisörer"]</span>
            <span>@T["Bilhandlare"]</span>
            <span>@T["Psykologer"]</span>
            <span>@T["Konsultbolag"]</span>
            <span>@T["Mäklare"]</span>
            <span>@T["Föreningar"]</span>
            <span>@T["Tandläkare"]</span>
            <span>@T["Läkare"]</span>
            <span>@T["Konstnärer"]</span>
            <span>@T["Skolor"]</span>
            <span>@T["Butiker"]</span>
        </div>
    </div>
</section>

<section class="section">
    <div class="container reveal">
        <header class="section-head text-center">
            <h2>@T["Verktyg & plattformar vi använder"]</h2>
        </header>
        <div class="logo-scroller">
            <div class="scroller__inner">
                <img src="~/img/tools/wordpress.svg" alt="WordPress" />
                <img src="~/img/tools/Shopify.svg" alt="Shopify" />
                <img src="~/img/tools/onecom.webp" alt="one.com" />
                <img src="~/img/tools/elementor.webp" alt="Elementor Pro" />
                <img src="~/img/tools/visualstudio.svg" alt="Visual Studio" />

            </div>
        </div>
    </div>
</section>

<section class="section section--soft">
    <div class="container reveal">
        <header class="section-head text-center">
            <h2>@T["Vi hjälper dig med"]</h2>
            <br />
        </header>
        <div class="svc-carousel" style="position:relative">
            <button class="snap-btn snap-prev" aria-label="@T["Föregående"]"></button>
            <button class="snap-btn snap-next" aria-label="@T["Nästa"]"></button>
            <div class="svc-grid">
                <article class="svc-card">
                    <div class="svc-ico" style="--tone:#3b82f6" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 16 4 12l4-4M16 8l4 4-4 4M14 4 10 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></div>
                    <h3 class="svc-title">@T["Webbutveckling & e-handel"]</h3>
                    <p class="svc-text">@T["Snabba sidor och butiker som är lätta att äga och uppdatera."]</p>
                    <a class="svc-go" asp-controller="Services" asp-action="Web" aria-label="@T["Webbutveckling & e-handel"]">
                        <svg viewBox="0 0 24 24"><path d="M8 5l8 7-8 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </a>
                </article>
                <article class="svc-card">
                    <div class="svc-ico" style="--tone:#7c3aed" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="10" cy="10" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M14.5 14.5 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></div>
                    <h3 class="svc-title">@T["Design & UX"]</h3>
                    <p class="svc-text">@T["Form och funktion i balans – UI som inspirerar och konverterar."]</p>
                    <a class="svc-go" asp-controller="Services" asp-action="Design" aria-label="@T["Design & UX"]">
                        <svg viewBox="0 0 24 24"><path d="M8 5l8 7-8 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </a>
                </article>
                <article class="svc-card">
                    <div class="svc-ico" style="--tone:#ef4444" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 12h16M4 6h16M4 18h10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></div>
                    <h3 class="svc-title">@T["Digital marknadsföring"]</h3>
                    <p class="svc-text">@T["SEO, SEM och innehåll som höjer kvaliteten på trafiken och lyfter konverteringen."]</p>
                    <a class="svc-go" asp-controller="Services" asp-action="Marketing" aria-label="@T["Till marknadsföring"]">
                        <svg viewBox="0 0 24 24"><path d="M8 5l8 7-8 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </a>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="section section--soft">
    <div class="container container--narrow reveal">
        <header class="section-head text-center">
            <h2>@T["Vanliga frågor"]</h2>
            <p>@T["Kort och tydligt om process, tid och support."]</p>
        </header>
        <div class="faq">
            <article class="faq-item">
                <h3 class="sr-only">@T["Fråga 1"]</h3>
                <button class="faq-q" aria-expanded="false" aria-controls="faq-a-1" id="faq-q-1">
                    @T["Hur ser processen ut från start till lansering?"]
                    <span class="faq-ico" aria-hidden="true"></span>
                </button>
                <div class="faq-a" id="faq-a-1" role="region" aria-labelledby="faq-q-1">
                    <div class="faq-a__inner">
                        @T["Vi börjar med mål & scope, tar fram struktur/wireframes, designar gränssnitt, bygger och testar.Löpande avstämningar, sedan lansering och uppföljning."]
                    </div>
                </div>
            </article>
            <article class="faq-item">
                <h3 class="sr-only">@T["Fråga 2"]</h3>
                <button class="faq-q" aria-expanded="false" aria-controls="faq-a-2" id="faq-q-2">
                    @T["Hur lång tid tar ett projekt?"]
                    <span class="faq-ico" aria-hidden="true"></span>
                </button>
                <div class="faq-a" id="faq-a-2" role="region" aria-labelledby="faq-q-2">
                    <div class="faq-a__inner">
                        @T["Vanliga webbplatser tar ofta 1–3 veckor beroende på omfattning, innehåll och integrationer."]
                    </div>
                </div>
            </article>

            <article class="faq-item">
                <h3 class="sr-only">@T["Fråga 4"]</h3>
                <button class="faq-q" aria-expanded="false" aria-controls="faq-a-4" id="faq-q-4">
                    @T["Vad händer efter att webbplatsen är lanserad? Erbjuder ni support?"]
                    <span class="faq-ico" aria-hidden="true"></span>
                </button>
                <div class="faq-a" id="faq-a-4" role="region" aria-labelledby="faq-q-4">
                    <div class="faq-a__inner">
                        @T["Absolut. Efter lansering ingår 30 dagars teknisk support för att säkerställa att allt fungerar som det ska. Därefter erbjuder vi anpassade serviceavtal för löpande underhåll, säkerhetsuppdateringar och vidareutveckling."]
                    </div>
                </div>
            </article>

            <article class="faq-item">
                <h3 class="sr-only">@T["Fråga 5"]</h3>
                <button class="faq-q" aria-expanded="false" aria-controls="faq-a-5" id="faq-q-5">
                    @T["Är sökmotoroptimering (SEO) inkluderat?"]
                    <span class="faq-ico" aria-hidden="true"></span>
                </button>
                <div class="faq-a" id="faq-a-5" role="region" aria-labelledby="faq-q-5">
                    <div class="faq-a__inner">
                        @T["Alla våra webbplatser byggs med teknisk SEO i grunden. Det innebär en sökmotorvänlig struktur, snabba laddningstider och mobilanpassning. För mer avancerad SEO, som innehållsstrategi och länkbygge, erbjuder vi separata paket."]
                    </div>
                </div>
            </article>

            <article class="faq-item">
                <h3 class="sr-only">@T["Fråga 6"]</h3>
                <button class="faq-q" aria-expanded="false" aria-controls="faq-a-6" id="faq-q-6">
                    @T["Vad behöver jag som kund förbereda eller bidra med?"]
                    <span class="faq-ico" aria-hidden="true"></span>
                </button>
                <div class="faq-a" id="faq-a-6" role="region" aria-labelledby="faq-q-6">
                    <div class="faq-a__inner">
                        @T["Det viktigaste du behöver bidra med är innehåll – det vill säga texter, bilder och eventuell logotyp. Vi guidar dig genom processen och kan även hjälpa till med att ta fram innehåll om du önskar det."]
                    </div>
                </div>
            </article>

        </div>
    </div>
</section>

<section class="cta-band">
    <div class="container">
        <div class="grid grid-2">
            <div>
                <h2>@T["Vill du veta vad vi kan göra för dig?"]</h2>
            </div>
            <div class="hero__actions">
                <a class="btn btn-primary" asp-controller="Pricing" asp-action="Index">@T["Se paket"]</a>
                <a class="btn btn-outline" href="mailto:info@tasmim.se">@T["Maila oss"]</a>
            </div>
        </div>
    </div>
</section>