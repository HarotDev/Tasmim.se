@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer T

@{
    ViewData["Title"] = T["Om oss – Tasmim"];
    Layout = "_Layout";
}

<section class="hero" style="--overlay:.45;">
    <div class="hero__bg"
         style="background-image:url('https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=2000&auto=format&fit=crop')">
    </div>
    <div class="hero__overlay"></div>

    <div class="container hero__inner">
        <h1 class="hero-title">@T["Vi bygger webb som är enkel att förstå och lätt att äga"]</h1>
        <p class="hero-sub">@T["Liten byrå, snabba beslut. Från idé till lansering utan krångel."]</p>
        <ul class="about-bullets" style="margin-bottom:var(--space-m)">
            <li>@T["Webbplatser och e-handel"]</li>
            <li>@T["Design, innehåll och SEO"]</li>
            <li>@T["Fasta upplägg och tydliga priser"]</li>
        </ul>
        <div class="hero__actions">
            <a class="btn btn-wipe" asp-controller="Home" asp-action="Contact">@T["Kontakta oss"]</a>
            <a class="btn btn-ghost" asp-controller="Home" asp-action="References">@T["Referenser"]</a>
        </div>
    </div>
</section>

<section class="section">
    <div class="container reveal">
        <header class="section-head text-center">
            <h2>@T["Därför väljer kunder oss"]</h2>
            <br />
        </header>
        <div class="cards grid grid-3">
            <article class="card">
                <h3>@T["Tydligt"]</h3>
                <p>@T["En kontakt, rak kommunikation och en process du ser från start till mål."]</p>
            </article>
            <article class="card">
                <h3>@T["Snabbt"]</h3>
                <p>@T["Vi jobbar i korta iterationer och visar tidigt – så vi gör rätt saker direkt."]</p>
            </article>
            <article class="card">
                <h3>@T["Ägbarhet"]</h3>
                <p>@T["Du får en sida som är lätt att uppdatera, skala och äga över tid."]</p>
            </article>
        </div>
    </div>
</section>

<section class="section section--soft">
    <div class="container reveal">
        <header class="section-head text-center">
            <h2>@T["Så går det till"]</h2>
            <br />
        </header>
        <div class="steps">
            <div class="step">
                <div class="no">1</div>
                <div>
                    <h3>@T["Start & plan"]</h3>
                    <p>@T["Vi sätter mål, scope och tidsplan. Du vet exakt vad som ingår."]</p>
                </div>
            </div>
            <div class="step">
                <div class="no">2</div>
                <div>
                    <h3>@T["Design & prototyp"]</h3>
                    <p>@T["Vi skissar snabbt och gör en klickbar prototyp som du kan testa."]</p>
                </div>
            </div>
            <div class="step">
                <div class="no">3</div>
                <div>
                    <h3>@T["Bygg & lansering"]</h3>
                    <p>@T["Vi utvecklar, testar och lanserar. Sedan hjälper vi dig komma igång."]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cta-band">
    <div class="container">
        <div class="grid grid-2" style="align-items:center">
            <div>
                <h2 class="hero-title">@T["Redo att starta?"]</h2>
                <p class="hero-sub">@T["Skriv några rader om vad du behöver – vi återkommer snabbt."]</p>
            </div>
            <div class="hero__actions" style="justify-content:flex-end">
                <a class="btn btn-outline" asp-controller="Home" asp-action="Contact">@T["Kontakta oss"]</a>
                <a class="btn btn-primary" asp-controller="Home" asp-action="References">@T["Referenser →"]</a>
            </div>
        </div>
    </div>
</section>
