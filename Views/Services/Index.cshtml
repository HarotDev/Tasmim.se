@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer T

@{
    ViewData["Title"] = T["Tjänster – Tasmim"];
    Layout = "_Layout";
}

<section class="hero" style="--overlay:.55;">
    <div class="hero__bg">
        <video class="hero__video"
               autoplay muted loop playsinline preload="auto"
               poster="">
            <source src="~/videos/serviceindexvideo.mp4" type="video/mp4" />
            @T["Din webbläsare stöder inte video-taggen."]
        </video>
    </div>
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="container hero__inner">
        <h1 class="hero-title">@T["Webbutveckling, e-handel och design."]</h1>
        <p class="hero-sub">@T["Vi bygger snabba sidor och butiker, och tar fram en design som är enkel att förstå och jobba med."]</p>
        <div class="hero__actions">
            <a class="btn btn-wipe" asp-controller="Pricing" asp-action="Index">@T["Se priser"]</a>
            <a class="btn btn-ghost" asp-controller="Home" asp-action="Contact">@T["Kontakta oss"]</a>
        </div>
    </div>
</section>

<section class="section">
    <div class="container reveal">
        <header class="section-head text-center">
            <h2>@T["Våra tjänster"]</h2>
            <p>@T["Tydliga erbjudanden, samma fokus: fart, enkelhet och resultat."]</p>
        </header>
        <div class="svc-carousel" style="position:relative">
            <button class="snap-btn snap-prev" aria-label='@T["Föregående"]'></button>
            <button class="snap-btn snap-next" aria-label='@T["Nästa"]'></button>
            <div class="svc-grid" data-snap>
                <article class="svc-card" style="--tone:#28b57b">
                    <div class="svc-ico" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                    </div>
                    <h3 class="svc-title">@T["Webbutveckling & e-handel"]</h3>
                    <p class="svc-text">@T["Sidor och butiker som laddar snabbt och är lätta att uppdatera."]</p>
                    <a class="svc-go" asp-controller="Services" asp-action="Web" aria-label='@T["Läs mer om Webbutveckling & e-handel"]'>
                        <svg viewBox="0 0 24 24" fill="none"><path d="M8 5l8 7-8 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </a>
                </article>
                <article class="svc-card" style="--tone:#7d5cff">
                    <div class="svc-ico" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M7 4v16M9 12h6M12 9v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                    </div>
                    <h3 class="svc-title">@T["Design & UX"]</h3>
                    <p class="svc-text">@T["Tydlig form och smarta gränssnitt. Vi tar fram ett UI som håller."]</p>
                    <a class="svc-go" asp-controller="Services" asp-action="Design" aria-label='@T["Läs mer om Design & UX"]'>
                        <svg viewBox="0 0 24 24" fill="none"><path d="M8 5l8 7-8 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </a>
                </article>
                <article class="svc-card">
                    <div class="svc-ico" style="--tone:#ef4444" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 12h16M4 6h16M4 18h10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></div>
                    <h3 class="svc-title">@T["Digital marknadsföring"]</h3>
                    <p class="svc-text">@T["SEO, SEM och innehåll som höjer kvaliteten på trafiken och lyfter konverteringen."]</p>
                    <a class="svc-go" asp-controller="Services" asp-action="Marketing" aria-label='@T["Till marknadsföring"]'>
                        <svg viewBox="0 0 24 24"><path d="M8 5l8 7-8 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </a>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="section section--soft">
    <div class="container reveal">
        <div class="grid grid-2 feature">
            <div class="feature-copy">
                <h2>@T["Bygg rätt från början"]</h2>
                <p>@T["Vi gör en enkel plan med mål, vad vi mäter och vad som ingår. Sedan bygger vi snabbt och testar hela tiden."]</p>
                <div class="hero__actions">
                    <a class="btn btn-wipe" asp-controller="Pricing" asp-action="Index">@T["Se paket"]</a>
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Contact">@T["Kontakta oss"]</a>
                </div>
            </div>
            <div class="feature-media">
                <div class="square">
                    <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=1600&auto=format&fit=crop" alt='@T["Team som planerar projekt"]'>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container reveal">
        <header class="section-head text-center">
            <h2>@T["Varför Tasmim?"]</h2>
            <p>@T["Vi kombinerar enkelhet i förvaltning med mätbar prestanda."]</p>
        </header>
        <div class="cards grid grid-3">
            <article class="card">
                <h3>@T["Snabb laddning"]</h3>
                <p>@T["Optimerade bilder, caching och modern bundling."]</p>
            </article>
            <article class="card">
                <h3>@T["Tillgänglig"]</h3>
                <p>@T["Tillgänglighet från start: tydlig kontrast, synligt fokus och allt ska gå att använda med tangentbord."]</p>
            </article>
            <article class="card">
                <h3>@T["Enkelt att äga"]</h3>
                <p>@T["Modulär struktur och kort introduktion vid överlämning."]</p>
            </article>
        </div>
    </div>
</section>

<section class="cta-band">
    <div class="container">
        <div class="grid grid-2">
            <div>
                <h2>@T["Redo att starta?"]</h2>
                <p>@T["Skriv några rader så återkommer vi med upplägg och fast pris."]</p>
            </div>
            <div class="hero__actions">
                <a class="btn btn-primary" asp-controller="Pricing" asp-action="Index">@T["Se paket"]</a>
                <a class="btn btn-outline" asp-controller="Home" asp-action="Contact">@T["Kontakta oss"]</a>
            </div>
        </div>
    </div>
</section>
