@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer T

@{
    ViewData["Title"] = T["Design & UX – Tasmim"];
    Layout = "_Layout";
}

<section class="hero" style="--overlay:.50;">
    <div class="hero__bg">
        <video class="hero__video"
               autoplay muted loop playsinline preload="auto"
               poster="">
            <source src="~/videos/designhero.mp4" type="video/mp4" />
            @T["Din webbläsare stöder inte video-taggen."]
        </video>
    </div>
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="container hero__inner">
        <h1 class="hero-title">@T["Design & UX som känns självklar"]</h1>
        <p class="hero-sub">@T["Vi skapar tydliga gränssnitt och hållbara UI-kit som gör det enkelt att växa och förvalta."]</p>
        <div class="hero__actions">
            <a class="btn btn-primary" asp-controller="Pricing" asp-action="Index">@T["Se paket"]</a>
            <a class="btn btn-outline" asp-controller="Home" asp-action="Contact">@T["Kontakta oss"]</a>
        </div>
    </div>
</section>

<section class="section">
    <div class="container reveal">
        <header class="section-head text-center">
            <h2>@T["Vad ingår?"]</h2>
            <p>@T["Ett smidigt flöde från struktur till färdigt designsystem – optimerat för fart och tydlighet."]</p>
        </header>
        <div class="cards grid grid-3">
            <article class="card">
                <h3>@T["Designsystem"]</h3>
                <p>@T["Komponenter, färger och typografi som håller ihop och skalar."]</p>
            </article>
            <article class="card">
                <h3>@T["Prototyper"]</h3>
                <p>@T["Snabba klickbara prototyper för beslut och tidiga tester."]</p>
            </article>
            <article class="card">
                <h3>@T["Varumärkesgrund"]</h3>
                <p>@T["Ton, uttryck och riktlinjer så allt känns konsekvent."]</p>
            </article>
        </div>
    </div>
</section>

<section class="section section--soft">
    <div class="container reveal">
        <div class="grid grid-2 feature">
            <div class="feature-copy">
                <h2>@T["Från idé till designsystem"]</h2>
                <p>@T["Vi börjar i innehållet, definierar hierarki och flöden, och bygger sedan ett lättanvänt UI-kit som gör uppdateringar snabba och trygga."]</p>
                <div class="hero__actions">
                    <a class="btn btn-outline" asp-controller="Home" asp-action="About">@T["Hur vi jobbar"]</a>
                    <a class="btn btn-primary" asp-controller="Pricing" asp-action="Index">@T["Se prisexempel"]</a>
                </div>
            </div>
            <div class="feature-media">
                <div class="square">
                    <img src="https://images.unsplash.com/photo-1558655146-9f40138edfeb?q=80&w=1600&auto=format&fit=crop" alt='@T["UI-komponenter och prototyper"]'>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container reveal">
        <header class="section-head text-center">
            <h2>@T["Vår process"]</h2>
            <p class="muted">@T["Tydliga steg, korta loopar och beslut på riktig användarfeedback."]</p>
        </header>
        <ol class="steps">
            <li class="step">
                <div class="no">1</div>
                <div>
                    <h3>@T["Upptäck"]</h3>
                    <p>@T["Mål, målgrupper och innehåll. Vi samlar krav och definierar KPI:er."]</p>
                </div>
            </li>
            <li class="step">
                <div class="no">2</div>
                <div>
                    <h3>@T["Struktur"]</h3>
                    <p>@T["Informationsarkitektur, wireframes och navigationsmönster."]</p>
                </div>
            </li>
            <li class="step">
                <div class="no">3</div>
                <div>
                    <h3>@T["UI"]</h3>
                    <p>@T["Komponenter, färger och typografi - som prototyp testas och förbättras."]</p>
                </div>
            </li>
            <li class="step">
                <div class="no">4</div>
                <div>
                    <h3>@T["Handoff"]</h3>
                    <p>@T["Specar och bibliotek för smidig utveckling och förvaltning."]</p>
                </div>
            </li>
        </ol>
    </div>
</section>

<section class="section section--soft">
    <div class="container reveal">
        <header class="section-head text-center">
            <h2>@T["Tjänster i detalj"]</h2>
            <p>@T["Välj insats eller kombinera – vi anpassar efter mål och budget."]</p>
        </header>
        <div class="cards grid grid-3">
            <article class="card">
                <h3>@T["UI-kit"]</h3>
                <ul class="ticks">
                    <li>@T["Knapp-, formulär- och kortkomponenter"]</li>
                    <li>@T["Färger, typografi och ikoner"]</li>
                    <li>@T["Tillgänglighet och states"]</li>
                </ul>
            </article>
            <article class="card">
                <h3>@T["Designsystem"]</h3>
                <ul class="ticks">
                    <li>@T["Tokens och naming"]</li>
                    <li>@T["Mönster och guidelines"]</li>
                    <li>@T["Versionering & dokumentation"]</li>
                </ul>
            </article>
            <article class="card">
                <h3>@T["Prototyp & test"]</h3>
                <ul class="ticks">
                    <li>@T["Klickbara flöden"]</li>
                    <li>@T["Snabba användartester"]</li>
                    <li>@T["Funnel- och A/B-upplägg"]</li>
                </ul>
            </article>
        </div>
    </div>
</section>

<section class="cta-band">
    <div class="container">
        <div class="grid grid-2">
            <div>
                <h2>@T["Redo att uppdatera ert uttryck?"]</h2>
                <p>@T["Vi tar fram ett UI-kit och en startsida som sätter tonen."]</p>
            </div>
            <div class="hero__actions">
                <a class="btn btn-primary" asp-controller="Pricing" asp-action="Index">@T["Se paket"]</a>
                <a class="btn btn-outline" asp-controller="Home" asp-action="Contact">@T["Kontakta oss"]</a>
            </div>
        </div>
    </div>
</section>
