@{
    ViewData["Title"] = "Design & UX – Tasmim";
    Layout = "_Layout";
}

<section class="hero" style="--overlay:.50;">
    <div class="hero__bg">
        <video class="hero__video"
               autoplay
               muted
               loop
               playsinline
               preload="auto"
               poster="https://images.unsplash.com/photo-1587620962725-abab7fe55159?q=80&w=2000&auto=format&fit=crop">
            <source src="~/videos/designhero.mp4" type="video/mp4" />
            Din webbläsare stöder inte video-taggen.
        </video>
    </div>
    <div class="hero__overlay" aria-hidden="true"></div>

    <div class="container hero__inner">
        <h1 class="hero-title">Design & UX som känns självklar</h1>
        <p class="hero-sub">Vi skapar tydliga gränssnitt och hållbara UI-kit som gör det enkelt att växa och förvalta.</p>
        <div class="hero__actions">
            <a class="btn btn-primary" asp-controller="Pricing" asp-action="Index">Se paket</a>
            <a class="btn btn-outline" asp-controller="Home" asp-action="Contact">Boka ett samtal</a>
        </div>
    </div>
</section>

<section class="section reveal">
    <div class="container">
            <h2>Vad ingår?</h2>
            <p class="muted">Ett smidigt flöde från struktur till färdigt designsystem – optimerat för fart och tydlighet.</p>

        <div class="cards grid grid-3">
            <article class="card">
                <h3>Designsystem</h3>
                <p class="muted">Komponenter, färger och typografi som håller ihop och skalar.</p>
            </article>
            <article class="card">
                <h3>Prototyper</h3>
                <p class="muted">Snabba klickbara prototyper för beslut och tidiga tester.</p>
            </article>
            <article class="card">
                <h3>Varumärkesgrund</h3>
                <p class="muted">Ton, uttryck och riktlinjer så allt känns konsekvent.</p>
            </article>
        </div>
    </div>
</section>

<section class="section feature-split reveal">
    <div class="container grid-2 grid feature">
        <div class="feature-copy">
            <h2>Från idé till designsystem</h2>
            <p class="muted">Vi börjar i innehållet, definierar hierarki och flöden, och bygger sedan ett lättanvänt UI-kit som gör uppdateringar snabba och trygga.</p>
            <div class="hero__actions">
                <a class="btn btn-outline" asp-controller="Home" asp-action="About">Hur vi jobbar</a>
                <a class="btn btn-primary" asp-controller="Pricing" asp-action="Index">Se prisexempel</a>
            </div>
        </div>
        <div class="feature-media">
            <div class="square">
                <img src="https://images.unsplash.com/photo-1558655146-9f40138edfeb?q=80&w=1600&auto=format&fit=crop" alt="UI-komponenter och prototyper">
            </div>
        </div>
    </div>
</section>

<section class="section section--soft reveal">
    <div class="container">
            <h2>Vår process</h2>
            <p class="muted">Tydliga steg, korta loopar och beslut på riktig användarfeedback.</p>

        <ol class="steps">
            <li class="step">
                <div class="no">1</div>
                <div>
                    <h3>Upptäck</h3>
                    <p class="muted">Mål, målgrupper och innehåll. Vi samlar krav och definierar KPI:er.</p>
                </div>
            </li>
            <li class="step">
                <div class="no">2</div>
                <div>
                    <h3>Struktur</h3>
                    <p class="muted">Informationsarkitektur, wireframes och navigationsmönster.</p>
                </div>
            </li>
            <li class="step">
                <div class="no">3</div>
                <div>
                    <h3>UI</h3>
                    <p class="muted">Komponenter, färger och typografi - som prototyp testas och förbättras.</p>
                </div>
            </li>
            <li class="step">
                <div class="no">4</div>
                <div>
                    <h3>Handoff</h3>
                    <p class="muted">Specar och bibliotek för smidig utveckling och förvaltning.</p>
                </div>
            </li>
        </ol>
    </div>
</section>

<section class="section reveal">
    <div class="container">
            <h2>Tjänster i detalj</h2>
            <p class="muted">Välj insats eller kombinera – vi anpassar efter mål och budget.</p>

        <div class="cards grid grid-3">
            <article class="card">
                <h3>UI-kit</h3>
                <ul class="ticks">
                    <li>Knapp-, formulär- och kortkomponenter</li>
                    <li>Färger, typografi och ikoner</li>
                    <li>Tillgänglighet och states</li>
                </ul>
            </article>

            <article class="card">
                <h3>Designsystem</h3>
                <ul class="ticks">
                    <li>Tokens och naming</li>
                    <li>Mönster och guidelines</li>
                    <li>Versionering & dokumentation</li>
                </ul>
            </article>

            <article class="card">
                <h3>Prototyp & test</h3>
                <ul class="ticks">
                    <li>Klickbara flöden</li>
                    <li>Snabba användartester</li>
                    <li>Funnel- och A/B-upplägg</li>
                </ul>
            </article>
        </div>
    </div>
</section>

<section class="cta-band">
    <div class="container">
        <div class="grid grid-2">
            <div>
                <h2>Redo att uppdatera ert uttryck?</h2>
                <p>Vi tar fram ett UI-kit och en startsida som sätter tonen.</p>
            </div>
            <div class="hero__actions">
                <a class="btn btn-primary" asp-controller="Pricing" asp-action="Index">Se paket</a>
                <a class="btn btn-outline" asp-controller="Home" asp-action="Contact">Kontakta oss</a>
            </div>
        </div>
    </div>
</section>
