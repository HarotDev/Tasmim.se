@{
    ViewData["Title"] = "Tack för din beställning – Tasmim";
    Layout = "_Layout";

    var category = TempData["Category"] as string;
    var plan = TempData["Plan"] as string;
    var price = TempData["Price"] as string;
}

<section class="section success-section">
    <div class="container reveal">
        <div class="success-wrap reveal">

            <div class="success-badge" aria-hidden="true">
                <svg viewBox="0 0 48 48" role="img" aria-label="Order mottagen">
                    <circle class="ring" cx="24" cy="24" r="22"></circle>
                    <path class="check" d="M16 24.5l5.2 5.3L32 18" fill="none" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>

            <h1>Tack! Din beställning är mottagen.</h1>
            <p class="muted">Vi hör av oss inom kort för att bekräfta detaljer och nästa steg.</p>

            @if (!string.IsNullOrWhiteSpace(category) && !string.IsNullOrWhiteSpace(plan))
            {
                <div class="success-pill">
                    <strong>@category • @plan</strong>
                    @if (!string.IsNullOrWhiteSpace(price))
                    {
                        <span>@price</span>
                    }
                </div>
            }

            <ol class="success-steps">
                <li><strong>Bekräftelse:</strong> Du får ett mejl med sammanfattning.</li>
                <li><strong>Kickoff:</strong> Vi föreslår tid för ett kort samtal.</li>
                <li><strong>Underlag:</strong> Ev. texter/bilder kan skickas när det passar.</li>
            </ol>

            <div class="success-actions">
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Till startsidan</a>
                <a class="btn btn-outline" asp-controller="Pricing" asp-action="Index">Se paket igen</a>
                <a class="btn btn-outline" href="mailto:hello@tasmim.se">Kontakta oss</a>
            </div>

        </div>
    </div>
</section>
