@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer T
@model RaqmiWeb.Models.OrderRequest

@{
    ViewData["Title"] = T["Beställ – {0} {1}", T[Model.Category.ToString()], T[Model.Plan]];
    Layout = "_Layout";
}

<section class="section order-section">
    <div class="container">
        <header class="section-head text-center reveal">
            <h1>@T["Beställ"] @T[Model.Category.ToString()] – @T[Model.Plan]</h1>
            <p>@T["Fyll i dina uppgifter så återkommer vi snabbt och bekräftar."]</p>

            <div class="order-pill small-only">
                <strong>@T[Model.Category.ToString()] • @T[Model.Plan]</strong>
                <span>@Model.FormattedPrice</span>
            </div>
        </header>

        <div class="order-shell reveal">
            <form asp-action="Submit" method="post"
                  class="contact-form order-form card"
                  novalidate>
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Category" />
                <input type="hidden" asp-for="Plan" />
                <input type="hidden" asp-for="Price" />

                <div class="order-grid" role="group" aria-labelledby="order-form-title">
                    <h2 id="order-form-title" class="sr-only">@T["Dina uppgifter"]</h2>

                    <div class="field">
                        <label asp-for="Name">@T["Namn *"]</label>
                        <input asp-for="Name" class="input" autocomplete="name" required aria-required="true" />
                        <span asp-validation-for="Name" class="error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Email">@T["E-post *"]</label>
                        <input asp-for="Email" class="input" type="email" autocomplete="email" inputmode="email" required aria-required="true" />
                        <span asp-validation-for="Email" class="error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Phone">@T["Mobil"]</label>
                        <input asp-for="Phone" class="input" type="tel" autocomplete="tel" inputmode="tel" placeholder="@T["+46 7X XXX XX XX"]" dir="ltr" />
                        <span asp-validation-for="Phone" class="error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Domain">@T["Domän (om du har)"]</label>
                        <input asp-for="Domain" class="input" placeholder="@T["t.ex. dittföretag.se"]" inputmode="url" autocomplete="url" />
                        <div class="hint">@T["Skriv utan http(s) om du vill – vi fixar resten."]</div>
                    </div>

                    <div class="field">
                        <label asp-for="CustomerType">@T["Kundtyp"]</label>
                        <select asp-for="CustomerType" class="select" autocomplete="organization-title">
                            <option>@T["Företag"]</option>
                            <option>@T["Privat"]</option>
                        </select>
                    </div>

                    <div class="field field--full">
                        <label asp-for="Notes">@T["Övrigt"]</label>
                        <textarea asp-for="Notes" rows="6" class="textarea" placeholder='@T["Berätta kort om företaget och vad du vill göra."]'></textarea>
                    </div>
                </div>

                <div class="agree-row">
                    <label class="agree">
                        <input type="checkbox" required aria-required="true" />
                        @T["Jag godkänner att ni kontaktar mig om min förfrågan."]
                    </label>
                    <div asp-validation-summary="ModelOnly" class="alert" role="alert"></div>
                </div>

                <div class="form-actions">
                    <button class="btn btn-primary" type="submit" data-loading='@T["Skickar…"]'>@T["Skicka beställning"]</button>
                    <span class="small muted">@T["Du får en bekräftelse via e-post."]</span>
                </div>
            </form>

            <aside class="order-summary card">
                <header class="summary-head">
                    <p class="eyebrow">@T["Din beställning"]</p>
                    <h3>@T[Model.Category.ToString()]</h3>
                    <div class="summary-plan">
                        <strong>@T[Model.Plan]</strong>
                        <span class="price">@Model.FormattedPrice</span>
                    </div>
                </header>

                <ul class="summary-features">
                    <li>@T["Mobilanpassad & snabb"]</li>
                    <li>@T["Grundläggande SEO"]</li>
                    <li>@T["Personlig kontakt"]</li>
                    <li>@T["Support vid start"]</li>
                </ul>

                <div class="summary-note">
                    <small class="muted">@T["Leveransplan och eventuella tillval bestämmer vi tillsammans."]</small>
                </div>
            </aside>
        </div>
    </div>
</section>